# GitHub API
GITHUB_TOKEN=ghp_local_dummy_token
GITHUB_API_URL=https://api.github.com

# Classifier
CLASSIFIER_BACKEND=ensemble
CLASSIFIER_CATBOOST_ITERATIONS=1000
CLASSIFIER_FLAKY_THRESHOLD=0.7

# LLM (optional)
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o
BYTEZ_API_KEY=b72c830aee09a35f763208e26c948eef
# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_CORS_ORIGINS=["http://localhost:3000"]
DASHBOARD_DEBUG=false

# Analysis
ANALYSIS_MAX_FILE_SIZE_BYTES=1000000
ANALYSIS_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO